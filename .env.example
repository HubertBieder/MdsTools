# woy.env – Vorlage (Dummy-Werte). Echte Werte nur in %USERPROFILE%\.woy\woy.env, nie in Git.
# Install.ps1 kopiert diese Datei als woy.env.example nach %USERPROFILE%\.woy und legt daraus eine woy.env an,
# wenn es dort noch keine gibt. Beschreibung der Schlüssel: MdsTools.md, Abschnitt "Anmeldedaten: woy.env".
# Bei User oder Passwort '*' oder '!' fragt Get-WoyCredential interaktiv nach.
WOY_SERVER_USER=DOMAIN\benutzer
WOY_SERVER_PASS=*
WOY_TESTSRV=TEST-SRV
